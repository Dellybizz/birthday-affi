# Copy to apps/admin/.env.local and apps/web/.env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback (optional):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only seed/provisioning scripts; never needed by the web or admin app:
SUPABASE_SERVICE_ROLE_KEY=
# Public content lookup is always scoped to one site:
NEXT_PUBLIC_SITE_SLUG=wiffeyyyy-os
# Admin editor "View live" target. Set this to the public web app origin, without a path.
NEXT_PUBLIC_WEB_URL=
# Shared server-only secret used by the admin app to invalidate the web app's public CMS cache after a release.
# Configure the same strong random value in both deployments. Never expose it with a NEXT_PUBLIC_ prefix.
CMS_REVALIDATE_SECRET=
PREVIEW_TOKEN_SECRET=
